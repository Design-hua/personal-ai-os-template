# ===== 必填：DeepSeek API Key =====
# 获取：https://platform.deepseek.com/ → 注册 → API Keys → 创建
# 粘贴到等号后面，形如：DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=

# ===== 可选：端口与数据目录（一般不用改）=====
PORT=3000
DATA_ROOT=./data

# ===== 以下为高级功能（飞书集成/视频拆解），不填就不启用，核心功能不受影响 =====
# 需要时参考「部署指南（人看版）.md」的高级章节逐项填写
# LARK_APP_ID=
# LARK_APP_SECRET=
# LARK_REDIRECT_BASE=
# LARK_SYNC_ENABLED=false
# LARK_NOTIFY_ENABLED=true
# LARK_BASE_TOKEN=
# LARK_VIDEO_TABLE_ID=
# SILICONFLOW_API_KEY=
